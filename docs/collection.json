{
  "info": {
    "name": "laravel-nova-event API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost"
    },
    {
      "key": "api_prefix",
      "value": "modules/events/api/v1"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "event_public_id",
      "value": ""
    },
    {
      "key": "event_category_id",
      "value": ""
    },
    {
      "key": "order_id",
      "value": ""
    },
    {
      "key": "store_id",
      "value": ""
    },
    {
      "key": "timeslot_id",
      "value": ""
    },
    {
      "key": "check_in_code",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Public",
      "item": [
        {
          "name": "List events",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/{{api_prefix}}/events?per_page=15",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_prefix}}",
                "events"
              ],
              "query": [
                {
                  "key": "per_page",
                  "value": "15"
                }
              ]
            }
          }
        },
        {
          "name": "Get event (by public_id)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/{{api_prefix}}/events/{{event_public_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_prefix}}",
                "events",
                "{{event_public_id}}"
              ]
            }
          }
        },
        {
          "name": "List event categories",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/{{api_prefix}}/event-categories?per_page=50",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_prefix}}",
                "event-categories"
              ],
              "query": [
                {
                  "key": "per_page",
                  "value": "50"
                }
              ]
            }
          }
        },
        {
          "name": "Get event category (by id)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/{{api_prefix}}/event-categories/{{event_category_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_prefix}}",
                "event-categories",
                "{{event_category_id}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Reservations",
      "item": [
        {
          "name": "Create reservation (guest, event stock)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 1,\n  \"first_name\": \"Demo\",\n  \"last_name\": \"Guest\",\n  \"gender\": \"M\",\n  \"area_code\": \"+86\",\n  \"phone_number\": \"13800138000\"\n}\n"
            },
            "url": {
              "raw": "{{base_url}}/{{api_prefix}}/events/{{event_public_id}}/reservations",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_prefix}}",
                "events",
                "{{event_public_id}}",
                "reservations"
              ]
            }
          }
        },
        {
          "name": "Create reservation (guest, store stock)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 1,\n  \"store_id\": {{store_id}},\n  \"first_name\": \"Demo\",\n  \"last_name\": \"Guest\",\n  \"gender\": \"M\",\n  \"area_code\": \"+86\",\n  \"phone_number\": \"13800138000\"\n}\n"
            },
            "url": {
              "raw": "{{base_url}}/{{api_prefix}}/events/{{event_public_id}}/reservations",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_prefix}}",
                "events",
                "{{event_public_id}}",
                "reservations"
              ]
            }
          }
        },
        {
          "name": "Create reservation (guest, timeslot stock)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 1,\n  \"timeslot_id\": \"{{timeslot_id}}\",\n  \"first_name\": \"Demo\",\n  \"last_name\": \"Guest\",\n  \"gender\": \"M\",\n  \"area_code\": \"+86\",\n  \"phone_number\": \"13800138000\"\n}\n"
            },
            "url": {
              "raw": "{{base_url}}/{{api_prefix}}/events/{{event_public_id}}/reservations",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_prefix}}",
                "events",
                "{{event_public_id}}",
                "reservations"
              ]
            }
          }
        },
        {
          "name": "Create reservation (authenticated)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 1,\n  \"store_id\": {{store_id}}\n}\n"
            },
            "url": {
              "raw": "{{base_url}}/{{api_prefix}}/events/{{event_public_id}}/reservations",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_prefix}}",
                "events",
                "{{event_public_id}}",
                "reservations"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Authenticated",
      "item": [
        {
          "name": "My reservations",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/{{api_prefix}}/me/reservations?per_page=15",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_prefix}}",
                "me",
                "reservations"
              ],
              "query": [
                {
                  "key": "per_page",
                  "value": "15"
                }
              ]
            }
          }
        },
        {
          "name": "My reservation detail (by order id)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/{{api_prefix}}/me/reservations/{{order_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_prefix}}",
                "me",
                "reservations",
                "{{order_id}}"
              ]
            }
          }
        },
        {
          "name": "Cancel my reservation (by order id)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/{{api_prefix}}/me/reservations/{{order_id}}/cancel",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_prefix}}",
                "me",
                "reservations",
                "{{order_id}}",
                "cancel"
              ]
            }
          }
        },
        {
          "name": "Check-in by code",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"check_in_code\": \"{{check_in_code}}\"\n}\n"
            },
            "url": {
              "raw": "{{base_url}}/{{api_prefix}}/reservations/check-in",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_prefix}}",
                "reservations",
                "check-in"
              ]
            }
          }
        }
      ]
    }
  ]
}

